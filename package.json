{
  "name": "cypress-api-automation",
  "version": "1.0.0",
  "description": "Cypress API Testing Framework",
  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "test:api": "cypress run --spec 'cypress/e2e/api/**/*.cy.js'",
    "test:integration": "cypress run --spec 'cypress/e2e/integration/**/*.cy.js'",
    "test:unit": "cypress run --spec 'cypress/e2e/unit/**/*.cy.js'",
    "test:report": "cypress run --reporter mochawesome --reporter-options reportDir=cypress/reports,overwrite=false,html=true,json=true",
    "generate:api-report": "node generate-report.js",
    "test:full-report": "npm run test:api && npm run generate:api-report",
    "test:single": "cypress run --spec",
    "test:single-report": "cypress run --spec cypress/e2e/api/beneficiary-find-by-email.cy.js && npm run generate:api-report",
    "test:e2e": "cypress run --spec 'cypress/e2e/integration/**/*.cy.js'",
    "test:e2e-report": "cypress run --spec 'cypress/e2e/integration/**/*.cy.js' && npm run generate:api-report",
    "test:3api": "cypress run --spec 'cypress/e2e/integration/three-api-workflow.cy.js'",
    "test:3api-report": "cypress run --spec 'cypress/e2e/integration/three-api-workflow.cy.js' && npm run generate:api-report",
    "report:ui": "npm run generate:api-report"
  },
  "devDependencies": {
    "cypress": "^13.6.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.3.0",
    "mochawesome-report-generator": "^6.2.0"
  }
}