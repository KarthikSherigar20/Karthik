              "context": null,
              "code": "// Target the visible logo image link specifically, not hidden breadcrumb links\ncy.get('#masthead a').filter(':visible') // exclude any element hidden via CSS\n.first().as('logo').should('exist').and('be.visible');\ncy.get('@logo').then($el => {\n  const style = window.getComputedStyle($el[0]);\n  expect(style.display).to.not.eq('none');\n  expect(style.visibility).to.not.eq('hidden');\n  expect(style.opacity).to.not.eq('0');\n  const rect = $el[0].getBoundingClientRect();\n  expect(rect.width).to.be.closeTo(200, 5);\n  expect(rect.height).to.be.closeTo(80, 5);\n});\ncy.get('@logo').invoke('attr', 'href').should('match', /home/);\ncy.get('@logo').find('img, svg').should('exist');",
